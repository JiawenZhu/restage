# Copy to .env — which is gitignored and must stay that way.
#
# This key is read ONLY on the server. It must never reach the browser:
# no NEXT_PUBLIC_ prefix, no localStorage, no client component. The open-source
# studios we evaluated do exactly that (localStorage.setItem('muapi_key', …)),
# which is fine for a desktop app holding the user's own key and unacceptable
# for a hosted product holding ours.
GEMINI_API_KEY=

# Optional. Defaults are chosen for cost: frames run on the cheap fast models
# because the plan expects to throw some away; only the approved frame is
# rendered to video.
# RESTAGE_IMAGE_MODEL=gemini-3-pro-image
# RESTAGE_VIDEO_MODEL=veo-3.1-fast-generate-preview

# ── Cloudflare R2 — finished videos only ─────────────────────────────────────
# Create the token yourself at R2 → Manage API tokens. Scope it to Object Read &
# Write on the `video-renders` bucket, not the whole account: a leaked
# account-wide token can delete every bucket you own.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# S3 endpoint, derived from the account id above:
# https://<your-account-id>.r2.cloudflarestorage.com

# ── Firebase — profiles, preferences, avatars, run/tree structure ────────────
# A NEW project, not CareerVivid's. The client keys below are public by design
# (Firebase security rules do the protecting), which is why they carry the
# NEXT_PUBLIC_ prefix and GEMINI_API_KEY never does.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-side admin credentials — never NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT_JSON=
