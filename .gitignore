node_modules/
dist/
.DS_Store
.env
.env.*
*.local
# The template is the one env file that SHOULD be committed — it documents the
# shape and carries no values. Listed after `.env.*` and after `*.local`,
# because a later rule wins and `.env.example` is caught by the first.
!.env.example

# Generated media — regenerate rather than commit
/out/
*.mp4

# Next.js
web/node_modules/
web/.next/
web/next-env.d.ts

# Template preview clips are generated assets, regenerable with
# `npx tsx scripts/make-template-previews.mts`. They are committed on purpose —
# a fresh clone should show the gallery without spending Veo credits.
#
# The global *.mp4 rule above was quietly excluding them, so lib/templatePreviews.ts
# (which IS committed) advertised three clips that no clone would have. Roughly
# 2MB total, and regenerating them costs a Veo render each.
!web/public/templates/*.mp4

# The landing page's hero ad, made by scripts/make-hero-ad.mts through the real
# pipeline. Same reasoning as the template clips above and a sharper failure:
# the *.mp4 rule would keep it out of a fresh clone AND out of the Docker build
# context, so the deployed hero would be a broken <video> on the one page whose
# argument is that the output is good. 6MB, and regenerating it costs three Veo
# renders.
!web/public/hero-ad.mp4
web/public/templates/.generating

# TypeScript incremental build cache — regenerated by every `tsc` run, so
# tracking it means a permanently dirty tree and pointless merge conflicts.
*.tsbuildinfo
*.log
firebase-debug.log

# Hackathon submission video production assets and renders
hackathon-video/
*.wav
probe/

