rules_version = '2';

/*
 * Default deny. Every path below has to earn its access explicitly — a rule set
 * that starts permissive and adds restrictions leaks the paths nobody thought
 * about, which for this product means one user's face and another user's runs.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Profile and preferences.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      /*
       * Billing and credentials. NOT the owner's to read or write.
       *
       * The document above is owner-read/owner-WRITE, which is right for
       * preferences and wrong for anything that decides who pays. Two things
       * cannot live there:
       *
       *   plan — 'paid' routes a run onto infrastructure Restage pays for. If
       *   the client can write it, upgrading yourself is one setDoc() in the
       *   browser console, and the only record is a bill.
       *
       *   geminiKeyEnc — the user's own API key, encrypted. The ciphertext is
       *   not the key, but sending it to a browser buys nothing and is one
       *   configuration mistake away from being the key. It never needs to
       *   leave the server, so it never should.
       *
       * `if false` denies every CLIENT path. The Admin SDK bypasses rules
       * entirely, so the API routes still read and write this freely — which is
       * the point: these fields move when the server says so, not when a user
       * does.
       */
      match /private/{document} {
        allow read, write: if false;
      }

      /*
       * Enrolment captures are biometric-adjacent. Only the owner reads them —
       * no "public avatars" path, no sharing by link — and NOBODY writes them
       * from a client.
       *
       * Client write was allowed here, and the avatar document stores Storage
       * PATHS which GET /api/avatars signs with admin credentials. Admin
       * signing bypasses storage rules, so a forged document naming
       * `users/<someone-else>/avatars/.../front.jpg` would have been signed and
       * returned — a read of another user's face through a document the
       * attacker was permitted to write. Writes go through the API, which takes
       * the uid from the token and builds the path itself.
       */
      match /avatars/{avatarId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // The taste model is written by the server as it learns from rejections.
      // The client may read it — the whole point is that it is legible — but
      // must not edit it, or "what the agent learned" becomes user-authored.
      match /taste/{attribute} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    /*
     * Spend ceilings. Server-only in both directions: a client that could read
     * its own counter learns nothing useful, and one that could write it would
     * simply reset the limit — which is the whole point of the limit.
     */
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // A run and its tree.
    match /runs/{runId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      /*
       * Server-only creation.
       *
       * A client could create a runs/{id} document carrying arbitrary
       * server-owned fields — videoKey, avatarUrl, previewFrames — and the
       * server reads those back and acts on them: videoKey is signed against
       * the private renders bucket with admin credentials, and avatarUrl is
       * fetched server-side. That is a signing oracle and a fetch primitive,
       * reachable by anyone with an account. Runs are created through
       * POST /api/runs, which builds every one of those fields itself.
       */
      allow create: if false;

      // Only the goal and status are the user's to change. Everything else —
      // the plan, the verdicts, the credit cost — is the server's account of
      // what happened, and a client that can rewrite it can fake the record.
      allow update: if signedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['goal', 'status', 'updatedAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;

      // Nodes are written by the server only. A client that could write a node
      // could award itself a passing critic verdict.
      match /nodes/{nodeId} {
        allow read: if signedIn() && get(/databases/$(database)/documents/runs/$(runId)).data.uid == request.auth.uid;
        allow write: if false;
      }
    }
  }
}
