# Restage — environment
#
# Copy to .env.local and fill in. .env.local is gitignored and must stay that
# way: it carries a Gemini key, a service account, and R2 credentials.
#
# Nothing in this file is a real value.

# ── Required ─────────────────────────────────────────────────────────────────

# Google AI Studio key. https://aistudio.google.com/apikey
# This is the key Restage runs on by default; a user who saves their own
# overrides it. Without this, every run fails with a clear message.
GEMINI_API_KEY=

# Firebase web config. Console → Project settings → Your apps.
# NEXT_PUBLIC_ is correct here and only here — these are public by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Service-account JSON on ONE line, for the Admin SDK (Firestore + Storage).
# Console → Project settings → Service accounts → Generate new private key.
# Never prefix this with NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Optional ─────────────────────────────────────────────────────────────────

# Encrypts a user's own API key at rest (AES-256-GCM). Only needed once people
# can save their own key. Any long random string; changing it makes every
# already-saved key undecryptable.
RESTAGE_KEY_SECRET=

# Cloudflare R2, for finished clips. Without it, rendering has nowhere to put
# the video.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Veo submissions per minute. The free tier is 2; a sequence render fires one
# job per shot, so without pacing seven shots arrive as a burst against a limit
# of two. Raise this after upgrading billing.
RESTAGE_VEO_RPM=2

# ── Paid path (Vertex AI) — dormant unless deliberately enabled ───────────────

# Leave unset. Setting it to `vertex` routes every run to Vertex AI.
RESTAGE_DEFAULT_PROVIDER=

# `global` serves the 3.x models. Every region tested serves only the 2.5
# family, which produces visibly worse ads — pin a region only for data
# residency, and know that is the trade.
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_PROJECT=

# ── Development ──────────────────────────────────────────────────────────────

# Stands in for a signed-in user in scripts/. Not read in production.
RESTAGE_DEV_UID=
